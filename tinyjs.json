{
  "name": "nib",
  "title": "Nib",
  "size": "560x468",
  "id": "art.tarwin.nib",
  "version": "0.8.1",
  "minTinyjsVersion": "0.57.0",
  "backend": "src/backend/main.ts",
  "frontend": {
    "build": "pnpm run build",
    "dist": "web-dist",
    "dev": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173"
  },
  "update": {
    "url": "https://github.com/tarwin/tinyjs-nib/releases/latest/download/manifest.json",
    "auto": "daily"
  },
  "fileExtensions": [
    "md",
    "markdown",
    "mdown",
    "mkdn",
    "mkd",
    "mdwn",
    "mdtxt",
    "mdtext"
  ],
  "openFolders": true,
  "about": "menu",
  "permissions": {
    "microphone": "Nib uses the microphone only while you are dictating into a document.",
    "speechRecognition": "Dictation turns what you say into text at your caret."
  },
  "windows": {
    "chrome": {
      "menu": false
    }
  },
  "linux": {
    "chrome": {
      "menu": false
    }
  }
}
