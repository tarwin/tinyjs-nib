exports[`--- as page breaks 1`] = `
"<p data-line=\\"0\\">one</p>\\n<div class=\\"pgbrk\\" data-kind=\\"pagebreak\\" contenteditable=\\"false\\" data-text=\\"---\\" data-line=\\"2\\"><span>page break</span></div>\\n<p data-line=\\"4\\">two</p>"
`;

exports[`every flavor off (CommonMark) 1`] = `
"<pre class=\\"fm\\" data-kind=\\"frontmatter\\" data-line=\\"0\\">title: Flavors\\ntags: [a, b]</pre>\\n<h1 id=\\"heading-one\\" data-line=\\"5\\">Heading one</h1>\\n<p data-line=\\"7\\">Some <em>emphasis</em>, <strong>strong</strong>, <code>code</code>, <del>gone</del>, a [link](<a href=\\"https://example.com\\">https://example.com</a> &quot;t&quot;),\\nan autolink <a href=\\"https://tinyjs.app\\">https://tinyjs.app</a>, and a <a href=\\"other.md#part\\">relative one</a>.\\nBad links stay inert: [js](javascript:alert(1)) and ![x](javascript:x).</p>\\n<blockquote data-line=\\"11\\"><p>[!NOTE]\\nAn alert with <strong>markup</strong>.</p></blockquote>\\n<blockquote data-line=\\"14\\"><p>[!WARNING]\\nCareful.</p></blockquote>\\n<ul data-line=\\"17\\"><li data-line=\\"17\\">one</li><li data-line=\\"18\\">two<ul><li data-line=\\"19\\">nested</li></ul></li><li class=\\"task\\" data-line=\\"20\\"><input type=\\"checkbox\\" data-line=\\"20\\"> todo</li><li class=\\"task done\\" data-line=\\"21\\"><input type=\\"checkbox\\" checked data-line=\\"21\\"> done</li></ul>\\n<ol data-line=\\"23\\"><li data-line=\\"23\\">first</li><li data-line=\\"24\\">second</li></ol>\\n<table data-line=\\"26\\"><thead><tr><th>Left</th><th style=\\"text-align:center\\">Centre</th><th style=\\"text-align:right\\">Right</th></tr></thead><tbody><tr><td>a</td><td style=\\"text-align:center\\">b</td><td style=\\"text-align:right\\">c</td></tr><tr><td>\`x</td><td style=\\"text-align:center\\">y\`</td><td style=\\"text-align:right\\"><strong>z</strong></td><td>3</td></tr></tbody></table>\\n<pre data-line=\\"31\\"><code class=\\"lang-js\\"><span class=\\"cd-kw\\">const</span> a <span class=\\"cd-op\\">=</span> <span class=\\"cd-num\\">1</span><span class=\\"cd-pun\\">;</span> <span class=\\"cd-cm\\">// a comment</span>\\n<span class=\\"cd-kw\\">function</span> <span class=\\"cd-fn\\">f</span><span class=\\"cd-pun\\">(</span>x<span class=\\"cd-pun\\">)</span> <span class=\\"cd-pun\\">{</span> <span class=\\"cd-kw\\">return</span> <span class=\\"cd-str\\">\`t \${x}\`</span><span class=\\"cd-pun\\">;</span> <span class=\\"cd-pun\\">}</span></code></pre>\\n<pre data-line=\\"36\\"><code class=\\"lang-mermaid\\">graph TD; A--&gt;B;</code></pre>\\n<p data-line=\\"40\\">Inline math $e^{i\\\\pi} + 1 = 0$ and a block:</p>\\n<p data-line=\\"42\\">$$\\n\\\\int_0^1 x\\\\,dx\\n$$</p>\\n<p data-line=\\"46\\">:tada: :+1: :not_a_code:</p>\\n<p data-line=\\"48\\">Footnote here[^1] and again[^note].</p>\\n<p data-line=\\"50\\">[^1]: The first.\\n[^note]: Named.</p>\\n<p data-line=\\"53\\">&lt;div align=&quot;center&quot;&gt;</p>\\n<p data-line=\\"55\\"><strong>Centred markdown</strong></p>\\n<p data-line=\\"57\\">&lt;/div&gt;</p>\\n<p data-line=\\"59\\">&lt;script&gt;alert('no')&lt;/script&gt;\\n&lt;img src=&quot;x&quot; onerror=&quot;alert(1)&quot;&gt;</p>\\n<hr data-text=\\"---\\" data-line=\\"62\\">\\n<p data-line=\\"64\\">Final paragraph with a hard<br>\\nbreak and a trailing \\\\\\nbackslash break.</p>"
`;

exports[`every flavor on (the defaults) 1`] = `
"<pre class=\\"fm\\" data-kind=\\"frontmatter\\" data-line=\\"0\\">title: Flavors\\ntags: [a, b]</pre>\\n<h1 id=\\"heading-one\\" data-line=\\"5\\">Heading one</h1>\\n<p data-line=\\"7\\">Some <em>emphasis</em>, <strong>strong</strong>, <code>code</code>, <del>gone</del>, a [link](<a href=\\"https://example.com\\">https://example.com</a> &quot;t&quot;),\\nan autolink <a href=\\"https://tinyjs.app\\">https://tinyjs.app</a>, and a <a href=\\"other.md#part\\">relative one</a>.\\nBad links stay inert: [js](javascript:alert(1)) and ![x](javascript:x).</p>\\n<div class=\\"cb cb-note\\" data-kind=\\"note\\" data-alert=\\"NOTE\\" data-line=\\"11\\"><p class=\\"cb-t\\">Note</p><p>An alert with <strong>markup</strong>.</p></div>\\n<div class=\\"cb cb-warning\\" data-kind=\\"warning\\" data-alert=\\"WARNING\\" data-line=\\"14\\"><p class=\\"cb-t\\">Warning</p><p>Careful.</p></div>\\n<ul data-line=\\"17\\"><li data-line=\\"17\\">one</li><li data-line=\\"18\\">two<ul><li data-line=\\"19\\">nested</li></ul></li><li class=\\"task\\" data-line=\\"20\\"><input type=\\"checkbox\\" data-line=\\"20\\"> todo</li><li class=\\"task done\\" data-line=\\"21\\"><input type=\\"checkbox\\" checked data-line=\\"21\\"> done</li></ul>\\n<ol data-line=\\"23\\"><li data-line=\\"23\\">first</li><li data-line=\\"24\\">second</li></ol>\\n<table data-line=\\"26\\"><thead><tr><th>Left</th><th style=\\"text-align:center\\">Centre</th><th style=\\"text-align:right\\">Right</th></tr></thead><tbody><tr><td>a</td><td style=\\"text-align:center\\">b</td><td style=\\"text-align:right\\">c</td></tr><tr><td>\`x</td><td style=\\"text-align:center\\">y\`</td><td style=\\"text-align:right\\"><strong>z</strong></td><td>3</td></tr></tbody></table>\\n<pre data-line=\\"31\\"><code class=\\"lang-js\\"><span class=\\"cd-kw\\">const</span> a <span class=\\"cd-op\\">=</span> <span class=\\"cd-num\\">1</span><span class=\\"cd-pun\\">;</span> <span class=\\"cd-cm\\">// a comment</span>\\n<span class=\\"cd-kw\\">function</span> <span class=\\"cd-fn\\">f</span><span class=\\"cd-pun\\">(</span>x<span class=\\"cd-pun\\">)</span> <span class=\\"cd-pun\\">{</span> <span class=\\"cd-kw\\">return</span> <span class=\\"cd-str\\">\`t \${x}\`</span><span class=\\"cd-pun\\">;</span> <span class=\\"cd-pun\\">}</span></code></pre>\\n<div class=\\"mm\\" data-kind=\\"mermaid\\" contenteditable=\\"false\\" data-text=\\"graph TD; A--&gt;B;\\" data-line=\\"36\\"><pre class=\\"mm-src\\"><code>graph TD; A--&gt;B;</code></pre></div>\\n<p data-line=\\"40\\">Inline math <span class=\\"math\\" data-kind=\\"math\\" contenteditable=\\"false\\" data-text=\\"e^{i\\\\pi} + 1 = 0\\"><code>e^{i\\\\pi} + 1 = 0</code></span> and a block:</p>\\n<div class=\\"math mblock\\" data-kind=\\"math\\" data-fence=\\"dollars\\" contenteditable=\\"false\\" data-text=\\"\\\\int_0^1 x\\\\,dx\\" data-line=\\"42\\"><code>\\\\int_0^1 x\\\\,dx</code></div>\\n<p data-line=\\"46\\"><span class=\\"emo\\" data-text=\\":tada:\\">🎉</span> <span class=\\"emo\\" data-text=\\":+1:\\">👍</span> :not_a_code:</p>\\n<p data-line=\\"48\\">Footnote here<sup class=\\"fnref\\" data-fn=\\"1\\"><a href=\\"#fn-1\\">1</a></sup> and again<sup class=\\"fnref\\" data-fn=\\"note\\"><a href=\\"#fn-note\\">2</a></sup>.</p>\\n<p data-line=\\"53\\">&lt;div align=&quot;center&quot;&gt;</p>\\n<p data-line=\\"55\\"><strong>Centred markdown</strong></p>\\n<p data-line=\\"57\\">&lt;/div&gt;</p>\\n<p data-line=\\"59\\">&lt;script&gt;alert('no')&lt;/script&gt;\\n&lt;img src=&quot;x&quot; onerror=&quot;alert(1)&quot;&gt;</p>\\n<hr data-text=\\"---\\" data-line=\\"62\\">\\n<p data-line=\\"64\\">Final paragraph with a hard<br>\\nbreak and a trailing \\\\\\nbackslash break.</p><section class=\\"footnotes\\" data-kind=\\"footnotes\\" contenteditable=\\"false\\"><ol><li id=\\"fn-1\\" data-fn=\\"1\\" data-line=\\"50\\">The first. <a class=\\"fn-back\\" href=\\"#\\" data-fn-back=\\"1\\">↩</a></li><li id=\\"fn-note\\" data-fn=\\"note\\" data-line=\\"51\\">Named. <a class=\\"fn-back\\" href=\\"#\\" data-fn-back=\\"note\\">↩</a></li></ol></section>"
`;

exports[`the example document 1`] = `
"<pre class=\\"fm\\" data-kind=\\"frontmatter\\" data-line=\\"0\\">title: Nib, by example\\nabout: front-matter is shown as-is, never parsed or hidden</pre>\\n<h1 id=\\"nib-by-example\\" data-line=\\"5\\">Nib, by example</h1>\\n<p data-line=\\"7\\">Everything Nib renders, in one document. Edit it freely — this is your own\\ncopy, and <strong>Help ▸ Open Example Document</strong> always brings back a fresh one.</p>\\n<div class=\\"cb cb-tip\\" data-kind=\\"tip\\" data-line=\\"10\\"><p class=\\"cb-t\\">Try this first</p><p data-line=\\"11\\">Hit <strong>⌘2</strong> for the split view, then the <strong>✎ Editable</strong> button (<strong>⌘⇧L</strong>) and\\ntype into the right-hand side. Your Markdown rewrites itself as you go — and\\nwhichever pane you're in, the other one shows you where you are.</p></div>\\n<div class=\\"toc\\" role=\\"navigation\\" data-kind=\\"toc\\" contenteditable=\\"false\\" data-arg=\\"On this page 2\\" data-text=\\"Built from the headings by \`::: toc\` — a title, then an optional level or\\nrange (\`2\`, \`2-3\`). It keeps itself up to date.\\" data-line=\\"16\\"><p class=\\"toc-t\\">On this page</p><div class=\\"toc-d\\"><p>Built from the headings by <code>::: toc</code> — a title, then an optional level or\\nrange (<code>2</code>, <code>2-3</code>). It keeps itself up to date.</p></div><ul><li><a href=\\"#nib-by-example\\">Nib, by example</a><ul><li><a href=\\"#headings\\">Headings</a></li><li><a href=\\"#words\\">Words</a></li><li><a href=\\"#lists\\">Lists</a></li><li><a href=\\"#quotes\\">Quotes</a></li><li><a href=\\"#code\\">Code</a></li><li><a href=\\"#tables\\">Tables</a></li><li><a href=\\"#links\\">Links</a></li><li><a href=\\"#images\\">Images</a></li><li><a href=\\"#rules\\">Rules</a></li><li><a href=\\"#page-breaks\\">Page breaks</a></li><li><a href=\\"#callouts\\">Callouts</a></li><li><a href=\\"#tabs\\">Tabs</a></li><li><a href=\\"#cards-carousels-and-embeds\\">Cards, carousels and embeds</a></li><li><a href=\\"#alerts\\">Alerts</a></li><li><a href=\\"#math\\">Math</a></li><li><a href=\\"#diagrams\\">Diagrams</a></li><li><a href=\\"#emoji-shortcodes\\">Emoji shortcodes</a></li><li><a href=\\"#footnotes\\">Footnotes</a></li><li><a href=\\"#raw-html\\">Raw HTML</a></li></ul></li></ul></div>\\n<h2 id=\\"headings\\" data-line=\\"21\\">Headings</h2>\\n<p data-line=\\"23\\">Use one to six <code>#</code> and a space. Every heading becomes an anchor and an entry\\nin the outline sidebar — <strong>⌘⇧O</strong> to slide it open — and in any <code>::: toc</code>.</p>\\n<h3 id=\\"third-level\\" data-line=\\"26\\">Third level</h3>\\n<h4 id=\\"fourth-level\\" data-line=\\"28\\">Fourth level</h4>\\n<h2 id=\\"words\\" data-line=\\"30\\">Words</h2>\\n<p data-line=\\"32\\">Text can be <em>italic</em>, <strong>bold</strong>, <strong><em>both at once</em></strong>, <del>struck out</del>,\\n<mark>highlighted</mark> or <code>inline code</code>. Underscores work too: <em>italic</em>, <strong>bold</strong>.\\nA backslash keeps a marker literal: *not italic*. And there's an emoji\\npicker in the toolbar (<strong>⌘⇧J</strong>) when you want one of these 🖋 🎉 ✅.</p>\\n<p data-line=\\"37\\">Paragraphs are separated by a blank line. Two spaces at the end of a line\\nforce a break inside one — like this,<br>\\nand this is the next line.</p>\\n<h2 id=\\"lists\\" data-line=\\"41\\">Lists</h2>\\n<ul data-line=\\"43\\"><li data-line=\\"43\\">A bullet list</li><li data-line=\\"44\\">takes <code>-</code>, <code>*</code> or <code>+</code><ul><li data-line=\\"45\\">and nests two spaces at a time<ul><li data-line=\\"46\\">as deep as you like</li></ul></li></ul></li><li data-line=\\"47\\">back to the top level</li></ul>\\n<ol data-line=\\"49\\"><li data-line=\\"49\\">Numbered lists</li><li data-line=\\"50\\">keep counting<ul><li data-line=\\"51\\">and mix with bullets</li></ul></li><li data-line=\\"52\\">as you'd expect</li></ol>\\n<ol start=\\"7\\" data-line=\\"54\\"><li data-line=\\"54\\">A list can start anywhere</li><li data-line=\\"55\\">and carries on from there</li></ol>\\n<h3 id=\\"task-lists\\" data-line=\\"57\\">Task lists</h3>\\n<p data-line=\\"59\\">Click these in the preview — the source line updates itself:</p>\\n<ul data-line=\\"61\\"><li class=\\"task done\\" data-line=\\"61\\"><input type=\\"checkbox\\" checked data-line=\\"61\\"> Write the renderer</li><li class=\\"task done\\" data-line=\\"62\\"><input type=\\"checkbox\\" checked data-line=\\"62\\"> Give every document a window</li><li class=\\"task\\" data-line=\\"63\\"><input type=\\"checkbox\\" data-line=\\"63\\"> Finish the novel<ul><li class=\\"task\\" data-line=\\"64\\"><input type=\\"checkbox\\" data-line=\\"64\\"> Chapter one</li><li class=\\"task\\" data-line=\\"65\\"><input type=\\"checkbox\\" data-line=\\"65\\"> Chapter two</li></ul></li></ul>\\n<h2 id=\\"quotes\\" data-line=\\"67\\">Quotes</h2>\\n<blockquote data-line=\\"69\\"><p>Markdown is intended to be as easy-to-read and easy-to-write as is feasible.</p>\\n<p>Readability, however, is emphasized above all else.</p>\\n<p>— John Gruber, 2004</p></blockquote>\\n<blockquote data-line=\\"75\\"><p>Quotes hold other blocks too:</p>\\n<ol><li>lists</li><li>code</li></ol>\\n<pre><code class=\\"lang-sh\\"><span class=\\"cd-fn\\">tinyjs</span> dev</code></pre></blockquote>\\n<h2 id=\\"code\\" data-line=\\"84\\">Code</h2>\\n<p data-line=\\"86\\">An inline <code>const</code> here, and a fenced block whose language picks the colours:</p>\\n<pre data-line=\\"88\\"><code class=\\"lang-js\\"><span class=\\"cd-cm\\">// nothing in here is treated as Markdown</span>\\n<span class=\\"cd-kw\\">export</span> <span class=\\"cd-kw\\">const</span> api <span class=\\"cd-op\\">=</span> <span class=\\"cd-pun\\">{</span>\\n  boot<span class=\\"cd-pun\\">:</span> <span class=\\"cd-kw\\">async</span> <span class=\\"cd-pun\\">(</span>_p<span class=\\"cd-pun\\">,</span> app<span class=\\"cd-pun\\">,</span> meta<span class=\\"cd-pun\\">)</span> <span class=\\"cd-op\\">=&gt;</span> <span class=\\"cd-pun\\">(</span><span class=\\"cd-pun\\">{</span> kind<span class=\\"cd-pun\\">:</span> <span class=\\"cd-str\\">'doc'</span><span class=\\"cd-pun\\">,</span> window<span class=\\"cd-pun\\">:</span> meta<span class=\\"cd-pun\\">.</span>window <span class=\\"cd-pun\\">}</span><span class=\\"cd-pun\\">)</span><span class=\\"cd-pun\\">,</span>\\n<span class=\\"cd-pun\\">}</span><span class=\\"cd-pun\\">;</span></code></pre>\\n<p data-line=\\"95\\">Tildes fence too, which is handy when the code itself has backticks:</p>\\n<pre data-line=\\"97\\"><code class=\\"lang-md\\">Use <span class=\\"cd-str\\">\`backticks\`</span> for code spans.</code></pre>\\n<h2 id=\\"tables\\" data-line=\\"101\\">Tables</h2>\\n<table data-line=\\"103\\"><thead><tr><th>Thing</th><th style=\\"text-align:center\\">Where it lives</th><th style=\\"text-align:right\\">Shortcut</th></tr></thead><tbody><tr><td>Editor</td><td style=\\"text-align:center\\"><code>doc.html</code></td><td style=\\"text-align:right\\">⌘1</td></tr><tr><td>Split</td><td style=\\"text-align:center\\">both panes</td><td style=\\"text-align:right\\">⌘2</td></tr><tr><td>Preview</td><td style=\\"text-align:center\\"><code>md.ts</code></td><td style=\\"text-align:right\\">⌘3</td></tr><tr><td>Outline</td><td style=\\"text-align:center\\">the sidebar</td><td style=\\"text-align:right\\">⌘⇧O</td></tr><tr><td>Editable</td><td style=\\"text-align:center\\"><code>unmd.ts</code></td><td style=\\"text-align:right\\">⌘⇧L</td></tr></tbody></table>\\n<p data-line=\\"111\\">The dashes row sets alignment: <code>:---</code> left, <code>:---:</code> centre, <code>---:</code> right.</p>\\n<h2 id=\\"links\\" data-line=\\"113\\">Links</h2>\\n<ul data-line=\\"115\\"><li data-line=\\"115\\">An ordinary <a href=\\"https://tinyjs.app\\">link to tinyjs</a></li><li data-line=\\"116\\">An autolink: <a href=\\"https://daringfireball.net/projects/markdown/\\">https://daringfireball.net/projects/markdown/</a></li><li data-line=\\"117\\">A bare one — <a href=\\"https://commonmark.org\\">https://commonmark.org</a> — spotted on sight</li><li data-line=\\"118\\">A <a href=\\"mailto:hello@example.com\\">mail link</a></li><li data-line=\\"119\\">A <a href=\\"#callouts\\">jump to the callouts</a> further down this page</li></ul>\\n<p data-line=\\"121\\">Web links open in your browser; a relative link to another <code>.md</code> file opens\\nit in a new Nib window.</p>\\n<h2 id=\\"images\\" data-line=\\"124\\">Images</h2>\\n<p data-line=\\"126\\">Relative paths are resolved next to this document and inlined by the backend,\\nso the window itself never touches the filesystem:</p>\\n<p class=\\"figp\\" data-line=\\"129\\"><span class=\\"fig\\" data-alt=\\"a small swatch\\"><img data-src=\\"nib-example-swatch.svg\\" alt=\\"a small swatch\\"></span></p>\\n<p data-line=\\"131\\">Paste an image with <strong>⌘V</strong>, drop a file on the window, or use\\n<strong>Format ▸ Insert Image…</strong> (<strong>⌘⇧I</strong>) — Nib copies it next to the document and\\nwrites the link for you. With <strong>✎ Editable</strong> on, click the picture above for\\nreplace / alt text / remove.</p>\\n<h2 id=\\"rules\\" data-line=\\"136\\">Rules</h2>\\n<p data-line=\\"138\\">Three or more dashes, asterisks or underscores:</p>\\n<hr data-text=\\"---\\" data-line=\\"140\\">\\n<h2 id=\\"page-breaks\\" data-line=\\"142\\">Page breaks</h2>\\n<p data-line=\\"144\\"><code>\\\\newpage</code> or <code>&lt;!-- pagebreak --&gt;</code> alone on a line. On screen it's the\\ndotted mark below; under <strong>⌘P</strong> (and in exported HTML) it starts a new page.</p>\\n<div class=\\"pgbrk\\" data-kind=\\"pagebreak\\" contenteditable=\\"false\\" data-text=\\"\\\\newpage\\" data-line=\\"147\\"><span>page break</span></div>\\n<p data-line=\\"149\\"><strong>Preview ▸ &quot;---&quot; as Page Break</strong> turns every dash rule into one too — <code>***</code>\\nand <code>___</code> stay rules. Other renderers shrug at both spellings: <code>\\\\newpage</code>\\nis plain text to them, a comment is nothing at all.</p>\\n<h2 id=\\"callouts\\" data-line=\\"153\\">Callouts</h2>\\n<p data-line=\\"155\\">Nib's one extension: three colons, a type, an optional title, three colons to\\nclose. The body is ordinary Markdown.</p>\\n<div class=\\"cb cb-note\\" data-kind=\\"note\\" data-line=\\"158\\"><p class=\\"cb-t\\">Note</p><p data-line=\\"159\\">The default type, when you don't name one.</p></div>\\n<div class=\\"cb cb-info\\" data-kind=\\"info\\" data-line=\\"162\\"><p class=\\"cb-t\\">Types available</p><p data-line=\\"163\\"><code>note</code> <code>info</code> <code>tip</code> <code>hint</code> <code>important</code> <code>warning</code> <code>caution</code> <code>danger</code>\\n<code>success</code> <code>bug</code> — plus <code>details</code>, below.</p></div>\\n<div class=\\"cb cb-warning\\" data-kind=\\"warning\\" data-line=\\"167\\"><p class=\\"cb-t\\">Careful</p><p data-line=\\"168\\">Callouts can hold <strong>anything</strong>:</p>\\n<ul data-line=\\"170\\"><li data-line=\\"170\\">lists</li><li data-line=\\"171\\">code</li><li data-line=\\"172\\">other callouts</li></ul>\\n<div class=\\"cb cb-danger\\" data-kind=\\"danger\\" data-line=\\"174\\"><p class=\\"cb-t\\">Nested</p><p data-line=\\"175\\">Right down inside each other.</p></div></div>\\n<details class=\\"cb cb-details\\" data-kind=\\"details\\" data-line=\\"179\\"><summary>A collapsed section</summary><p data-line=\\"180\\">This one is a real <code>&lt;details&gt;</code> element — click the title to fold it away.</p></details>\\n<div class=\\"cb\\" data-kind=\\"aside\\" data-line=\\"183\\"><p class=\\"cb-t\\">Unknown types are fine</p><p data-line=\\"184\\">A type Nib doesn't know gets neutral styling and its own name as the title.</p></div>\\n<h2 id=\\"tabs\\" data-line=\\"187\\">Tabs</h2>\\n<p data-line=\\"189\\"><code>::: tabs</code>, split by <code>== Title</code> lines. The switching is pure CSS, so tabs\\nsurvive <strong>Export as HTML</strong> — and printing simply shows every panel.</p>\\n<div class=\\"tabs\\" data-kind=\\"tabs\\" data-line=\\"192\\"><input type=\\"radio\\" name=\\"tab1\\" id=\\"tab1-0\\" checked><label for=\\"tab1-0\\">Writing</label><input type=\\"radio\\" name=\\"tab1\\" id=\\"tab1-1\\"><label for=\\"tab1-1\\">Keys</label><input type=\\"radio\\" name=\\"tab1\\" id=\\"tab1-2\\"><label for=\\"tab1-2\\">Why</label><div class=\\"tp\\" data-line=\\"194\\"><p data-line=\\"195\\">Type into either pane. With <strong>✎ Editable</strong> on, <code>## </code> and <code>**bold**</code> turn\\ninto the real thing as you finish them.</p></div><div class=\\"tp\\" data-line=\\"198\\"><table data-line=\\"199\\"><thead><tr><th>Action</th><th>Key</th></tr></thead><tbody><tr><td>Outline</td><td>⌘⇧O</td></tr><tr><td>Editable</td><td>⌘⇧L</td></tr><tr><td>Emoji</td><td>⌘⇧J</td></tr></tbody></table></div><div class=\\"tp\\" data-line=\\"205\\"><p data-line=\\"206\\">Because a tab strip is the one thing a long document always seems to want,\\nand three colons is a cheap price for it. Put the cursor in a hidden panel's\\nsource and the preview switches to that tab to show you.</p></div></div>\\n<h2 id=\\"cards-carousels-and-embeds\\" data-line=\\"212\\">Cards, carousels and embeds</h2>\\n<p data-line=\\"214\\">Four more <code>:::</code> blocks, each with its own toggle under <strong>Preview ▸\\nMarkdown Flavor</strong> (a folder's settings can carry them, so a whole project\\nagrees). Images become a strip that scrolls sideways — <code>small</code>,\\n<code>medium</code> or <code>large</code>:</p>\\n<div class=\\"carousel c-small\\" data-kind=\\"carousel\\" data-arg=\\"small\\" data-line=\\"219\\"><p class=\\"figp\\" data-line=\\"221\\"><img data-src=\\"nib-example-strip-1.svg\\" alt=\\"\\"></p>\\n<p class=\\"figp\\" data-line=\\"223\\"><span class=\\"fig\\" data-alt=\\"Alt text is the caption, with Image Captions on\\"><img data-src=\\"nib-example-strip-2.svg\\" alt=\\"Alt text is the caption, with Image Captions on\\"></span></p>\\n<p class=\\"figp\\" data-line=\\"225\\"><img data-src=\\"nib-example-strip-3.svg\\" alt=\\"\\"></p></div>\\n<p data-line=\\"229\\">A link dressed as a card, with the body as its description:</p>\\n<div class=\\"dlc dlc-download\\" data-kind=\\"download\\" data-line=\\"231\\"><svg class=\\"dlc-ico\\" viewBox=\\"0 0 24 24\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\" aria-hidden=\\"true\\"><path d=\\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\\"/><polyline points=\\"7 10 12 15 17 10\\"/><line x1=\\"12\\" x2=\\"12\\" y1=\\"15\\" y2=\\"3\\"/></svg><div class=\\"dlc-main\\"><p class=\\"dlc-t\\"><a href=\\"https://tinyjs.app\\">Nib, for the other machine</a></p><p data-line=\\"232\\">Clicking opens your browser, like any link — the card is just a louder way\\nto offer it.</p></div></div>\\n<div class=\\"dlc dlc-pagelink\\" data-kind=\\"pagelink\\" data-line=\\"236\\"><svg class=\\"dlc-ico\\" viewBox=\\"0 0 24 24\\" fill=\\"none\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\" aria-hidden=\\"true\\"><path d=\\"M15 3h6v6\\"/><path d=\\"M10 14 21 3\\"/><path d=\\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\\"/></svg><div class=\\"dlc-main\\"><p class=\\"dlc-t\\"><a href=\\"#callouts\\">Jump back to Callouts</a></p></div></div>\\n<p data-line=\\"239\\">And <code>::: embed &lt;url&gt;</code> asks the site itself — YouTube, Vimeo, Spotify,\\nFigma, CodePen and friends. It needs the network once; without it, the link\\nstays a link:</p>\\n<div class=\\"oemb\\" data-kind=\\"embed\\" contenteditable=\\"false\\" data-arg=\\"https://www.youtube.com/watch?v=aqz-KE-bpKQ\\" data-url=\\"https://www.youtube.com/watch?v=aqz-KE-bpKQ\\" data-text=\\"Big Buck Bunny — the body is the caption.\\" data-line=\\"243\\"><div class=\\"oemb-box\\"><a href=\\"https://www.youtube.com/watch?v=aqz-KE-bpKQ\\">https://www.youtube.com/watch?v=aqz-KE-bpKQ</a></div><div class=\\"oemb-cap\\"><p>Big Buck Bunny — the body is the caption.</p></div></div>\\n<h2 id=\\"alerts\\" data-line=\\"247\\">Alerts</h2>\\n<p data-line=\\"249\\">GitHub's spelling of a callout — a quote whose first line is <code>[!NOTE]</code>.\\nSame look as <code>:::</code>, but this form renders on GitHub too.</p>\\n<div class=\\"cb cb-note\\" data-kind=\\"note\\" data-alert=\\"NOTE\\" data-line=\\"252\\"><p class=\\"cb-t\\">Note</p><p>Handy things a reader can skim past.</p></div>\\n<div class=\\"cb cb-warning\\" data-kind=\\"warning\\" data-alert=\\"WARNING\\" data-line=\\"255\\"><p class=\\"cb-t\\">Warning</p><p>Things a reader had better not.</p></div>\\n<div class=\\"cb cb-tip\\" data-kind=\\"tip\\" data-alert=\\"TIP\\" data-line=\\"258\\"><p class=\\"cb-t\\">Tip</p><p><code>NOTE</code> <code>TIP</code> <code>IMPORTANT</code> <code>WARNING</code> <code>CAUTION</code> — toggle them under\\n<strong>Preview ▸ Markdown Flavor</strong>.</p></div>\\n<h2 id=\\"math\\" data-line=\\"262\\">Math</h2>\\n<p data-line=\\"264\\">TeX between dollars — <code>$e^{i\\\\pi} + 1 = 0$</code> renders as <span class=\\"math\\" data-kind=\\"math\\" contenteditable=\\"false\\" data-text=\\"e^{i\\\\pi} + 1 = 0\\"><code>e^{i\\\\pi} + 1 = 0</code></span>\\nright in the sentence. Two dollars (or a <code>\`</code>math fence) make a display\\nblock:</p>\\n<div class=\\"math mblock\\" data-kind=\\"math\\" data-fence=\\"dollars\\" contenteditable=\\"false\\" data-text=\\"\\\\int_0^\\\\infty e^{-x^2}\\\\,dx = \\\\frac{\\\\sqrt{\\\\pi}}{2}\\" data-line=\\"268\\"><code>\\\\int_0^\\\\infty e^{-x^2}\\\\,dx = \\\\frac{\\\\sqrt{\\\\pi}}{2}</code></div>\\n<div class=\\"math mblock\\" data-kind=\\"math\\" data-fence=\\"ticks\\" contenteditable=\\"false\\" data-text=\\"\\\\begin{pmatrix} a &amp; b \\\\\\\\ c &amp; d \\\\end{pmatrix}\\n\\\\begin{pmatrix} x \\\\\\\\ y \\\\end{pmatrix} =\\n\\\\begin{pmatrix} ax + by \\\\\\\\ cx + dy \\\\end{pmatrix}\\" data-line=\\"272\\"><code>\\\\begin{pmatrix} a &amp; b \\\\\\\\ c &amp; d \\\\end{pmatrix}\\n\\\\begin{pmatrix} x \\\\\\\\ y \\\\end{pmatrix} =\\n\\\\begin{pmatrix} ax + by \\\\\\\\ cx + dy \\\\end{pmatrix}</code></div>\\n<p data-line=\\"278\\">It compiles to native MathML (Temml), so exported HTML and printed pages\\ncarry real markup, no scripts. GitHub renders all three spellings too.</p>\\n<h2 id=\\"diagrams\\" data-line=\\"281\\">Diagrams</h2>\\n<p data-line=\\"283\\">A <code>\`</code>mermaid fence, drawn with <a href=\\"https://mermaid.js.org\\">Mermaid</a> — and\\ncoloured to match whichever preview theme you're wearing, so it never looks\\nlike a stranger's slide deck:</p>\\n<div class=\\"mm\\" data-kind=\\"mermaid\\" contenteditable=\\"false\\" data-text=\\"flowchart LR\\n  ed[Editor] --&gt;|render| pv[Preview]\\n  pv --&gt;|unmd.ts| ed\\n  pv --&gt; out[Outline]\\n  ed --&gt; hl[Colours]\\" data-line=\\"287\\"><pre class=\\"mm-src\\"><code>flowchart LR\\n  ed[Editor] --&gt;|render| pv[Preview]\\n  pv --&gt;|unmd.ts| ed\\n  pv --&gt; out[Outline]\\n  ed --&gt; hl[Colours]</code></pre></div>\\n<div class=\\"mm\\" data-kind=\\"mermaid\\" contenteditable=\\"false\\" data-text=\\"sequenceDiagram\\n  participant You\\n  participant Nib\\n  You-&gt;&gt;Nib: type\\n  Nib--&gt;&gt;You: rendered page\\n  You-&gt;&gt;Nib: ⌘S\\n  Nib--&gt;&gt;You: saved\\" data-line=\\"295\\"><pre class=\\"mm-src\\"><code>sequenceDiagram\\n  participant You\\n  participant Nib\\n  You-&gt;&gt;Nib: type\\n  Nib--&gt;&gt;You: rendered page\\n  You-&gt;&gt;Nib: ⌘S\\n  Nib--&gt;&gt;You: saved</code></pre></div>\\n<h2 id=\\"emoji-shortcodes\\" data-line=\\"305\\">Emoji shortcodes</h2>\\n<p data-line=\\"307\\">GitHub's <code>:name:</code> spellings become the real character: <span class=\\"emo\\" data-text=\\":tada:\\">🎉</span> <span class=\\"emo\\" data-text=\\":rocket:\\">🚀</span>\\n<span class=\\"emo\\" data-text=\\":bug:\\">🐛</span> <span class=\\"emo\\" data-text=\\":sparkles:\\">✨</span> <span class=\\"emo\\" data-text=\\":+1:\\">👍</span> — the full emojibase GitHub set, plus the picker's\\nown keywords. (The picker itself is ⌘⇧J.)</p>\\n<h2 id=\\"footnotes\\" data-line=\\"311\\">Footnotes</h2>\\n<p data-line=\\"313\\">A reference like this one<sup class=\\"fnref\\" data-fn=\\"1\\"><a href=\\"#fn-1\\">1</a></sup> becomes a numbered link, and the definitions\\ngather at the very end of the document<sup class=\\"fnref\\" data-fn=\\"why\\"><a href=\\"#fn-why\\">2</a></sup>, wherever you wrote them.</p>\\n<h2 id=\\"raw-html\\" data-line=\\"321\\">Raw HTML</h2>\\n<p data-line=\\"323\\">Shown as text, never executed — &lt;b&gt;this stays visible&lt;/b&gt;, and a\\n&lt;script&gt; tag can't do anything at all. A Nib window holds a private channel\\nto the backend, so a document must never be able to become markup.</p>\\n<hr data-text=\\"---\\" data-line=\\"327\\">\\n<p data-line=\\"329\\">Made with <a href=\\"https://tinyjs.app\\">Nib</a> 🖋</p><section class=\\"footnotes\\" data-kind=\\"footnotes\\" contenteditable=\\"false\\"><ol><li id=\\"fn-1\\" data-fn=\\"1\\" data-line=\\"316\\">The definition. It can run on,\\nas long as the continuation is indented. <a class=\\"fn-back\\" href=\\"#\\" data-fn-back=\\"1\\">↩</a></li><li id=\\"fn-why\\" data-fn=\\"why\\" data-line=\\"319\\">Because that is where a reader's eye goes looking for them. <a class=\\"fn-back\\" href=\\"#\\" data-fn-back=\\"why\\">↩</a></li></ol></section>"
`;

exports[`the sample document 1`] = `
"<h1 id=\\"welcome-to-nib\\" data-line=\\"0\\">Welcome to Nib</h1>\\n<p data-line=\\"2\\">A tiny Markdown editor where <strong>every document is its own window</strong>. This file\\nis a tour — open it with <code>tinyjs dev</code>, or drop it onto the Dock icon once the\\napp is running.</p>\\n<h2 id=\\"the-basics\\" data-line=\\"6\\">The basics</h2>\\n<p data-line=\\"8\\">Text can be <strong>bold</strong>, <em>italic</em>, <strong><em>both</em></strong>, <del>struck out</del>, or <code>inline code</code>.\\nLinks work too: <a href=\\"https://tinyjs.app\\">tinyjs</a>, autolinks like\\n<a href=\\"https://txikijs.org\\">https://txikijs.org</a>, and bare ones — <a href=\\"https://tinyjs.app/api\\">https://tinyjs.app/api</a> — become\\nclickable. Clicking any of them opens your <em>browser</em>, never the editor window.</p>\\n<p data-line=\\"13\\">Escapes render literally: *not italic*, and raw HTML is shown, not executed:\\n&lt;marquee&gt;nope&lt;/marquee&gt;.</p>\\n<blockquote data-line=\\"16\\"><p>Blockquotes hold anything —\\n<strong>formatting</strong>, <code>code</code>, even headings.</p>\\n<blockquote><p>And they nest.</p></blockquote></blockquote>\\n<h2 id=\\"lists\\" data-line=\\"21\\">Lists</h2>\\n<ol data-line=\\"23\\"><li data-line=\\"23\\">Ordered lists</li><li data-line=\\"24\\">Keep their numbers<ul><li data-line=\\"25\\">and nest unordered ones</li><li data-line=\\"26\\">with <em>formatting</em> inside</li></ul></li><li data-line=\\"27\\">Continuation lines\\njust join their item</li></ol>\\n<p data-line=\\"30\\">A task list — <strong>click the boxes in the preview</strong> and watch the source update:</p>\\n<ul data-line=\\"32\\"><li class=\\"task done\\" data-line=\\"32\\"><input type=\\"checkbox\\" checked data-line=\\"32\\"> Build a markdown renderer</li><li class=\\"task done\\" data-line=\\"33\\"><input type=\\"checkbox\\" checked data-line=\\"33\\"> One window per document</li><li class=\\"task\\" data-line=\\"34\\"><input type=\\"checkbox\\" data-line=\\"34\\"> Write something worth printing</li></ul>\\n<h2 id=\\"code\\" data-line=\\"36\\">Code</h2>\\n<pre data-line=\\"38\\"><code class=\\"lang-js\\"><span class=\\"cd-cm\\">// fenced code, kept verbatim</span>\\n<span class=\\"cd-kw\\">const</span> app <span class=\\"cd-op\\">=</span> <span class=\\"cd-kw\\">await</span> <span class=\\"cd-fn\\">openWindow</span><span class=\\"cd-pun\\">(</span><span class=\\"cd-str\\">'doc2'</span><span class=\\"cd-pun\\">,</span> <span class=\\"cd-pun\\">{</span> page<span class=\\"cd-pun\\">:</span> <span class=\\"cd-str\\">'doc.html'</span> <span class=\\"cd-pun\\">}</span><span class=\\"cd-pun\\">)</span><span class=\\"cd-pun\\">;</span>\\napp<span class=\\"cd-pun\\">.</span><span class=\\"cd-fn\\">push</span><span class=\\"cd-pun\\">(</span><span class=\\"cd-str\\">'doc-theme'</span><span class=\\"cd-pun\\">,</span> <span class=\\"cd-pun\\">{</span> theme<span class=\\"cd-pun\\">:</span> <span class=\\"cd-str\\">'night'</span> <span class=\\"cd-pun\\">}</span><span class=\\"cd-pun\\">)</span><span class=\\"cd-pun\\">;</span></code></pre>\\n<h2 id=\\"a-table\\" data-line=\\"44\\">A table</h2>\\n<table data-line=\\"46\\"><thead><tr><th>Feature</th><th style=\\"text-align:center\\">Where it lives</th><th style=\\"text-align:right\\">API</th></tr></thead><tbody><tr><td>One brain</td><td style=\\"text-align:center\\"><code>src/main.js</code></td><td style=\\"text-align:right\\"><code>app.win.open</code></td></tr><tr><td>Drafts</td><td style=\\"text-align:center\\">backend store</td><td style=\\"text-align:right\\"><code>onWindowClosed</code></td></tr><tr><td>PDF export</td><td style=\\"text-align:center\\">the print panel</td><td style=\\"text-align:right\\"><code>tiny.win.print()</code></td></tr></tbody></table>\\n<h2 id=\\"images\\" data-line=\\"52\\">Images</h2>\\n<p data-line=\\"54\\">Relative paths are resolved by the backend and inlined as data: URIs — the\\npage never reads the disk itself:</p>\\n<p class=\\"figp\\" data-line=\\"57\\"><span class=\\"fig\\" data-alt=\\"the Nib icon\\"><img data-src=\\"icon.png\\" alt=\\"the Nib icon\\"></span></p>\\n<hr data-text=\\"---\\" data-line=\\"59\\">\\n<p data-line=\\"61\\">Try <strong>⌘1 / ⌘2 / ⌘3</strong> for editor, split, and preview view; pick a theme in the\\n<strong>Preview ▸ Theme</strong> menu; then <strong>⌘P</strong> and <em>Save as PDF</em> — the theme goes with it.\\nNow make some edits and close this window with the red ✕. Reopen the file:\\nyour changes come back as a draft. That's the whole trick. 🖋</p>"
`;
